# Kopieren nach .env und Werte eintragen. .env gehört nie ins Git.

# Port des BFF. Vite leitet die Webchat-API im Dev-Modus an diesen Port weiter.
PORT=8090

# Öffentliche Adresse des Chatfensters (Schema + Host + Port, ohne Pfad).
# Die Webchat-API nimmt nur Anfragen mit diesem Origin an. Mehrere Werte mit Komma trennen.
# Lokal: 5173 = Chatfenster über Vite (npm run dev), 8090 = gebautes Chatfenster (npm run build && npm start).
WEBCHAT_PUBLIC_ORIGINS=http://localhost:5173,http://localhost:8090

# Agent Runtime, eine der beiden Varianten:
#   Lokaler Docker-Stack aus ../agent-runtime (docker compose up): http://localhost:8080
#   Stage über Proxy (gcloud run services proxy agent-runtime-api-stage --region europe-west3 --port 8081): http://localhost:8081
WEBCHAT_RUNTIME_URL=http://localhost:8080

# Authentifizierung gegenüber der Runtime zusätzlich zum API-Key:
#   none            lokal (Docker-Stack oder gcloud-Proxy, der das Token selbst setzt)
#   google-id-token Runtime auf Cloud Run mit IAM; das Dienstkonto des BFF braucht die Rolle „Cloud Run Invoker“.
#                   Das ID-Token kommt vom Metadata-Server, funktioniert also nur auf Google Cloud.
WEBCHAT_RUNTIME_AUTH=none
# Nur mit google-id-token: Audience des Tokens. Standard ist der Origin von WEBCHAT_RUNTIME_URL;
# setzen, wenn die Runtime über eine eigene Domain oder einen Load Balancer erreicht wird (dann die run.app-URL).
# WEBCHAT_RUNTIME_AUDIENCE=https://agent-runtime-api-prod-xxxxx.europe-west3.run.app

# Schlüssel für die Signatur der Conversation-Tokens. Mindestens 32 Bytes Zufall, z. B.:
#   openssl rand -base64 32
# Ändert sich der Wert, sind alle laufenden Gespräche im Browser ungültig und starten neu.
WEBCHAT_SIGNING_SECRET=

# Anzahl vertrauenswürdiger Proxies vor dem BFF (Load Balancer usw.).
# Die Client-IP ist der Eintrag in X-Forwarded-For, den der äußerste vertrauenswürdige Proxy angehängt hat.
# 0 = X-Forwarded-For ignorieren und die Socket-Adresse nehmen (lokal).
WEBCHAT_TRUSTED_PROXY_COUNT=0

# Nur für lokale Tests: zusätzliche Eltern-Origins für alle Tenants (Komma-getrennt),
# z. B. für die Testseite dev/parent.html. In Stage und Produktion leer lassen:
# Mit NODE_ENV=production und gesetzter Variable startet der Server nicht.
WEBCHAT_DEV_PARENT_ORIGINS=http://localhost:5174

# API-Keys der Runtime, je Tenant. Der Name der Variable steht in tenants/<slug>.json unter runtime.apiKeyEnv.
# Lokaler Docker-Stack: local-runtime-hh (Vorgabe aus RUNTIME_CONNECTIONS in ../agent-runtime/.env).
WEBCHAT_RUNTIME_API_KEY_HH=
