# Kopieren nach .env und Werte eintragen. .env gehört nie ins Git.

# Port des BFF
PORT=8080

# Öffentliche Adresse des Chatfensters (Schema + Host + Port, ohne Pfad).
# Die Webchat-API nimmt nur Anfragen mit diesem Origin an. Mehrere Werte mit Komma trennen.
# Lokal mit `npm run dev` läuft das Chatfenster über Vite auf Port 5173.
WEBCHAT_PUBLIC_ORIGINS=http://localhost:5173,http://localhost:8080

# Agent Runtime (lokal über: gcloud run services proxy agent-runtime-api-stage --region europe-west3 --port 8081)
WEBCHAT_RUNTIME_URL=http://localhost:8081

# Schlüssel für die Signatur der Conversation-Tokens. Mindestens 32 Bytes Zufall, z. B.:
#   openssl rand -base64 32
# Ändert sich der Wert, sind alle laufenden Gespräche im Browser ungültig und starten neu.
WEBCHAT_SIGNING_SECRET=

# Anzahl vertrauenswürdiger Proxies vor dem BFF (Load Balancer usw.).
# Die Client-IP ist der Eintrag in X-Forwarded-For, den der äußerste vertrauenswürdige Proxy angehängt hat.
# 0 = X-Forwarded-For ignorieren und die Socket-Adresse nehmen (lokal).
WEBCHAT_TRUSTED_PROXY_COUNT=0

# Nur für lokale Tests: zusätzliche Eltern-Origins für alle Tenants (Komma-getrennt),
# z. B. für die Testseite dev/parent.html. In Stage und Produktion leer lassen:
# Mit NODE_ENV=production und gesetzter Variable startet der Server nicht.
WEBCHAT_DEV_PARENT_ORIGINS=http://localhost:5174

# API-Keys der Runtime, je Tenant. Der Name der Variable steht in tenants/<slug>.json unter runtime.apiKeyEnv.
WEBCHAT_RUNTIME_API_KEY_HH=
